DEFUZZIFY Обр_колец_в_зоне_спек
    METHOD: LM ;
    UNITS: "ст. прин." ;
    RANGE := (0 .. 1) ;
    TERM соотвествует := LINEAR (0, 0) (1, 1) ;
END_DEFUZZIFY
DEFUZZIFY Обр_колец_перед_з_спек
    METHOD: LM ;
    UNITS: "ст. прин." ;
    RANGE := (0 .. 1) ;
    TERM соотвествует := LINEAR (0, 0) (1, 1) ;
END_DEFUZZIFY
DEFUZZIFY Охл_зоны_спекания
    METHOD: LM ;
    UNITS: "ст. прин." ;
    RANGE := (0 .. 1) ;
    TERM соотвествует := LINEAR (0, 0) (1, 1) ;
END_DEFUZZIFY
DEFUZZIFY Нагрев_зоны_спекания
    METHOD: LM ;
    UNITS: "ст. прин." ;
    RANGE := (0 .. 1) ;
    TERM соотвествует := LINEAR (0, 0) (1, 1) ;
END_DEFUZZIFY

RULEBLOCK Класс1
    OPERATION_BASE : MAXMIN , 29 ; 
    RULE rp_0_0 : IF (i_0 IS Z) AND (i_1 IS Z) AND (i_2 IS Z) AND (i_3 IS LN) AND (i_4 IS LN) AND (i_5 IS LN) AND (i_6 IS LN) AND (i_7 IS Z) AND (i_8 IS P) AND (i_9 IS LP) AND (i_10 IS Z) AND (no_0 IS Z) AND (no_1 IS Z) AND (no_2 IS Z) AND (no_3 IS Z) AND (no_4 IS Z) AND (no_5 IS Z) AND (no_6 IS LN) AND (no_7 IS LN) AND (no_8 IS N) AND (no_9 IS N) AND (no_10 IS N) THEN Обр_колец_в_зоне_спек IS соотвествует WITH 1 ;
